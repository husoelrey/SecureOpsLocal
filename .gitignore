# Synthetic fixtures and intentionally version-controlled log examples are safe data.
# Case definitions, migrations, manifests, documentation, and other text examples do
# not match the ignore rules above and therefore remain trackable by default.
!tests/fixtures/synthetic/**/*.log
!tests/fixtures/synthetic/**/*.log.*
!benchmark/cases/**/*.log
!benchmark/cases/**/*.log.*
!benchmarks/cases/**/*.log
!benchmarks/cases/**/*.log.*
!examples/synthetic/**/*.log
!examples/synthetic/**/*.log.*
!examples/version-controlled/**/*.log
!examples/version-controlled/**/*.log.*

